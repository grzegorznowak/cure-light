{
  "$id": "urn:cure-light:claim-run-labeling/1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Sliced-run labeling block of claim-run-manifest/2: the frame-slices/1 manifest, every child slice-proposals/1 file (one per slice), the merged claim-proposals/1 file and the proposal-reconciliation/1 report. Paths are relative to the run root (the manifest directory); digests are lowercase sha256 hex.",
  "properties": {
    "inputs": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "path": {
            "minLength": 1,
            "type": "string"
          },
          "sha256": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "slice_id": {
            "pattern": "^sha256:[0-9a-f]{64}$",
            "type": "string"
          }
        },
        "required": [
          "slice_id",
          "path",
          "sha256"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "merged": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "minLength": 1,
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "type": "object"
    },
    "mode": {
      "const": "sliced"
    },
    "reconciliation": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "minLength": 1,
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "type": "object"
    },
    "slices": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "minLength": 1,
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "type": "object"
    }
  },
  "required": [
    "mode",
    "slices",
    "inputs",
    "merged",
    "reconciliation"
  ],
  "title": "claim-run-labeling/1",
  "type": "object"
}
